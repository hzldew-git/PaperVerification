import NormEuclidean.OppositeHyperbolicUnipotent

/-!
# The subgroup generated by the two actual unipotent families
-/

noncomputable section

namespace NormEuclidean.HyperbolicUnipotentGroup

open ProperSpinor

variable {F E : Type*} [Field F] [CharZero F] [AddCommGroup E] [Module F E]
  [FiniteDimensional F E] (Q : QuadraticForm F E) (hQ : Q.polarBilin.Nondegenerate)
  (hA : Q.Anisotropic)

/-- The first actual unipotent family. -/
abbrev upper := HyperbolicUnipotent.element Q hQ hA

/-- The opposite actual unipotent family. -/
abbrev lower := OppositeHyperbolicUnipotent.element Q hQ hA

/-- The ordinary subgroup generated by both families, with no topological closure. -/
def generated : Subgroup (properGroup (Hyperbolic.form Q)) :=
  Subgroup.closure (Set.range (upper Q hQ hA) ∪ Set.range (lower Q hQ hA))

theorem upper_mem (u : E) : upper Q hQ hA u ∈ generated Q hQ hA :=
  Subgroup.subset_closure (Or.inl ⟨u, rfl⟩)

theorem lower_mem (u : E) : lower Q hQ hA u ∈ generated Q hQ hA :=
  Subgroup.subset_closure (Or.inr ⟨u, rfl⟩)

/-- Every finite unipotent word has trivial genuine Wall spinor norm. -/
theorem generated_le_kernel : generated Q hQ hA ≤
    (properAmbientSpinorNormHom (Hyperbolic.form Q)
      (Hyperbolic.form_polarBilin_nondegenerate Q hQ)).ker := by
  apply (Subgroup.closure_le _).2
  rintro g (⟨u, rfl⟩ | ⟨u, rfl⟩)
  · exact HyperbolicUnipotent.element_spinorNorm Q hQ hA u
  · exact OppositeHyperbolicUnipotent.element_spinorNorm Q hQ hA u

end NormEuclidean.HyperbolicUnipotentGroup
