import NormEuclidean.BinaryNormForm
import NormEuclidean.QuadraticRootFields
import Mathlib.FieldTheory.IsAlgClosed.Basic

/-!
# The negative Gram determinant field behind a binary norm frame

The frame parameter is the negative determinant of its actual associated
Gram matrix. The concrete quadratic algebra is identified with the field
generated by an actual root of that determinant in the common ambient
field, preserving the actual global field norm.
-/

noncomputable section

namespace NormEuclidean.BinaryDiscriminantField

open QuadraticExtensionNorm
open scoped IntermediateField

variable {K V Ω : Type*} [Field K] [Invertible (2 : K)]
  [AddCommGroup V] [Module K V] [Field Ω] [Algebra K Ω]
  {Q : QuadraticForm K V} {theta : Kˣ}

/-- The parameter is the actual negative associated Gram determinant. -/
theorem parameter_eq_neg_det (f : BinaryNormForm.Frame Q theta) :
    (theta : K) = -(LinearMap.toMatrix₂ f.basis f.basis Q.associated).det := by
  rw [f.parameter_eq, binary_gramDet_eq]
  ring

/-- Identify the norm algebra with the actual negative-determinant root field. -/
def equivNegativeDetRoot (htheta : ¬ IsSquare theta) (f : BinaryNormForm.Frame Q theta)
    (r : Ω) (hr : r ^ 2 = algebraMap K Ω
      (-(LinearMap.toMatrix₂ f.basis f.basis Q.associated).det)) :
    letI := quadraticExtensionField theta htheta
    QuadraticAlgebra K (theta : K) 0 ≃ₐ[K] K⟮r⟯ :=
  QuadraticRootFields.equivAdjoin theta htheta r
    (hr.trans (congrArg (algebraMap K Ω) (parameter_eq_neg_det f)).symm)

/-- The negative-determinant field model preserves the norm used in the idelic chain. -/
theorem norm_equivNegativeDetRoot (htheta : ¬ IsSquare theta)
    (f : BinaryNormForm.Frame Q theta) (r : Ω)
    (hr : r ^ 2 = algebraMap K Ω
      (-(LinearMap.toMatrix₂ f.basis f.basis Q.associated).det)) :
    letI := quadraticExtensionField theta htheta
    ∀ z : QuadraticAlgebra K (theta : K) 0,
      Algebra.norm K (equivNegativeDetRoot htheta f r hr z) = Algebra.norm K z := by
  letI := quadraticExtensionField theta htheta
  exact Algebra.norm_eq_of_algEquiv (equivNegativeDetRoot htheta f r hr)

/-- An algebraically closed ambient field supplies the actual discriminant root and model. -/
theorem exists_root_equiv [IsAlgClosed Ω] (htheta : ¬ IsSquare theta)
    (f : BinaryNormForm.Frame Q theta) :
    letI := quadraticExtensionField theta htheta
    ∃ r : Ω, r ^ 2 = algebraMap K Ω
        (-(LinearMap.toMatrix₂ f.basis f.basis Q.associated).det) ∧
      Nonempty (QuadraticAlgebra K (theta : K) 0 ≃ₐ[K] K⟮r⟯) := by
  letI := quadraticExtensionField theta htheta
  obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap K Ω (-(LinearMap.toMatrix₂ f.basis f.basis Q.associated).det))
    (by decide : 0 < 2)
  exact ⟨r, hr, ⟨equivNegativeDetRoot htheta f r hr⟩⟩

end NormEuclidean.BinaryDiscriminantField
