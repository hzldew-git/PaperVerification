import NormEuclidean.CompletedIntegralLattice
import Mathlib.LinearAlgebra.TensorProduct.Prod

/-!
# Completion and the standard hyperbolic extension

The canonical tensor/product equivalence is shown to preserve both the
quadratic form and the actual integral carrier, in both directions. This
requires no basis of the integral lattice and no inverse of two in the local
integer ring. It supplies a genuine local adapter for later genus arguments,
not a local classification or local-to-global theorem.
-/

open scoped TensorProduct
open IsDedekindDomain

namespace NormEuclidean.CompletedIntegralLattice

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
variable (R : Subring K) [IsDedekindDomain R] [IsFractionRing R K]
variable (v : HeightOneSpectrum R)

/-- Completion commutes with adjoining the standard hyperbolic plane. -/
noncomputable def hyperbolicEquiv :
    Space (V := Hyperbolic K V) R v ≃ₗ[LocalField R v]
      Hyperbolic (LocalField R v) (Space (V := V) R v) :=
  TensorProduct.prodRight K (LocalField R v) (LocalField R v) V (K × K) ≪≫ₗ
    (LinearEquiv.refl (LocalField R v) (Space (V := V) R v)).prodCongr
      (TensorProduct.prodRight K (LocalField R v) (LocalField R v) K K ≪≫ₗ
        (TensorProduct.AlgebraTensorModule.rid K (LocalField R v) (LocalField R v)).prodCongr
          (TensorProduct.AlgebraTensorModule.rid K (LocalField R v) (LocalField R v)))

@[simp] theorem hyperbolicEquiv_tmul (a : LocalField R v) (x : Hyperbolic K V) :
    hyperbolicEquiv R v (a ⊗ₜ[K] x) =
      (a ⊗ₜ[K] x.1, algebraMap K (LocalField R v) x.2.1 * a,
        algebraMap K (LocalField R v) x.2.2 * a) := by
  simp [hyperbolicEquiv, Algebra.smul_def]

@[simp] theorem hyperbolicEquiv_inclusion (x : Hyperbolic K V) :
    hyperbolicEquiv R v (inclusion R v x) =
      (inclusion R v x.1, algebraMap K (LocalField R v) x.2.1,
        algebraMap K (LocalField R v) x.2.2) := by
  simp [inclusion]

/-- Integral generators of the global hyperbolic extension remain integral in
the product coordinates after completion. -/
theorem hyperbolicEquiv_carrier_forward (L : Submodule R V)
    {z : Space (V := Hyperbolic K V) R v}
    (hz : z ∈ carrier R v (Hyperbolic.submodule L)) :
    hyperbolicEquiv R v z ∈ Hyperbolic.submodule (carrier R v L) := by
  induction hz using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨x, hx, rfl⟩ := hx
    rw [hyperbolicEquiv_inclusion]
    exact ⟨inclusion_mem R v L hx.1, algebraMap_mem R v hx.2.1,
      algebraMap_mem R v hx.2.2⟩
  | zero => simpa only [map_zero] using (Hyperbolic.submodule (carrier R v L)).zero_mem
  | add x y _ _ hx hy =>
    simpa only [map_add] using (Hyperbolic.submodule (carrier R v L)).add_mem hx hy
  | smul a x _ hx =>
    change hyperbolicEquiv R v ((a : LocalField R v) • x) ∈ _
    rw [map_smul]
    exact (Hyperbolic.submodule (carrier R v L)).smul_mem a hx

/-- Every integral vector in the completed hyperbolic product is generated by
global lattice vectors and the two standard hyperbolic basis vectors. -/
theorem hyperbolicEquiv_carrier_backward (L : Submodule R V)
    {z : Hyperbolic (LocalField R v) (Space (V := V) R v)}
    (hz : z ∈ Hyperbolic.submodule (carrier R v L)) :
    (hyperbolicEquiv R v).symm z ∈ carrier R v (Hyperbolic.submodule L) := by
  let E := hyperbolicEquiv (V := V) R v
  let P := carrier R v (Hyperbolic.submodule L)
  have hembed (x : Space (V := V) R v) (hx : x ∈ carrier R v L) :
      E.symm (Hyperbolic.embed x) ∈ P := by
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨x, hx, rfl⟩ := hx
      have heq : E.symm (Hyperbolic.embed (inclusion R v x)) =
          inclusion R v (Hyperbolic.embed x) := by
        apply E.symm_apply_eq.mpr
        simp [E, Hyperbolic.embed]
      rw [heq]
      exact inclusion_mem R v (Hyperbolic.submodule L) ((Hyperbolic.mem_embed x).2 hx)
    | zero =>
      change E.symm 0 ∈ P
      simpa only [map_zero] using P.zero_mem
    | add x y _ _ hx hy =>
      simpa only [Hyperbolic.embed_add, map_add] using P.add_mem hx hy
    | smul a x _ hx =>
      change E.symm (Hyperbolic.embed
        (algebraMap (LocalRing R v) (LocalField R v) a • x)) ∈ P
      rw [Hyperbolic.embed_smul (K := LocalField R v)
        (V := Space (V := V) R v), map_smul, IsScalarTower.algebraMap_smul]
      exact P.smul_mem a hx
  have he : E.symm Hyperbolic.e ∈ P := by
    have heq : E.symm Hyperbolic.e = inclusion R v (Hyperbolic.e : Hyperbolic K V) := by
      apply E.symm_apply_eq.mpr
      simp [E, Hyperbolic.e]
    rw [heq]
    exact inclusion_mem R v (Hyperbolic.submodule L) (Hyperbolic.mem_e L)
  have hf : E.symm Hyperbolic.f ∈ P := by
    have heq : E.symm Hyperbolic.f = inclusion R v (Hyperbolic.f : Hyperbolic K V) := by
      apply E.symm_apply_eq.mpr
      simp [E, Hyperbolic.f]
    rw [heq]
    exact inclusion_mem R v (Hyperbolic.submodule L) (Hyperbolic.mem_f L)
  have h := P.add_mem
    (P.add_mem (hembed z.1 hz.1) (P.smul_mem (⟨z.2.1, hz.2.1⟩ : LocalRing R v) he))
    (P.smul_mem (⟨z.2.2, hz.2.2⟩ : LocalRing R v) hf)
  have hdecomp : Hyperbolic.embed z.1 + z.2.1 • Hyperbolic.e + z.2.2 • Hyperbolic.f = z := by
    ext <;> simp [Hyperbolic.embed, Hyperbolic.e, Hyperbolic.f]
  change E.symm z ∈ P
  have h' : E.symm (Hyperbolic.embed z.1) + z.2.1 • E.symm Hyperbolic.e +
      z.2.2 • E.symm Hyperbolic.f ∈ P := by
    simpa only [← IsScalarTower.algebraMap_smul
      (R := LocalRing R v) (A := LocalField R v),
      Algebra.algebraMap_ofSubsemiring_apply] using h
  simpa only [← map_smul, ← map_add, hdecomp] using h'

/-- The canonical hyperbolic equivalence identifies the actual completed
integral carriers, without any choice of lattice basis. -/
theorem hyperbolicEquiv_carrier (L : Submodule R V)
    (z : Space (V := Hyperbolic K V) R v) :
    hyperbolicEquiv R v z ∈ Hyperbolic.submodule (carrier R v L) ↔
      z ∈ carrier R v (Hyperbolic.submodule L) := by
  constructor
  · intro hz
    simpa only [LinearEquiv.symm_apply_apply] using hyperbolicEquiv_carrier_backward R v L hz
  · exact hyperbolicEquiv_carrier_forward R v L

variable [Invertible (2 : K)]

/-- The canonical tensor/product equivalence preserves the hyperbolic quadratic form. -/
theorem hyperbolicEquiv_form (Q : QuadraticForm K V)
    (z : Space (V := Hyperbolic K V) R v) :
    Hyperbolic.form (form R v Q) (hyperbolicEquiv R v z) =
      form R v (Hyperbolic.form Q) z := by
  have h : (Hyperbolic.form (form R v Q)).comp (hyperbolicEquiv R v).toLinearMap =
      form R v (Hyperbolic.form Q) := by
    apply baseChange_ext
    intro x
    change Hyperbolic.form (form R v Q) (hyperbolicEquiv R v (inclusion R v x)) =
      form R v (Hyperbolic.form Q) (inclusion R v x)
    rw [hyperbolicEquiv_inclusion, form_inclusion]
    simp [Hyperbolic.q, form_inclusion]
  exact DFunLike.congr_fun h z

/-- Completing a hyperbolic lattice and adjoining a hyperbolic plane to the
completed lattice give canonically isometric integral lattices. -/
noncomputable def hyperbolicIsometry (Q : QuadraticForm K V) (L : Submodule R V) :
    LatticeIsometry (form R v (Hyperbolic.form Q)) (Hyperbolic.form (form R v Q))
      (carrier R v (Hyperbolic.submodule L)) (Hyperbolic.submodule (carrier R v L)) where
  toLinearEquiv := hyperbolicEquiv R v
  q_eq := hyperbolicEquiv_form R v Q
  mem_iff := hyperbolicEquiv_carrier R v L

end NormEuclidean.CompletedIntegralLattice
