import NormEuclidean.ChapterX.QuadraticSquareDescent
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.IntermediateField.Algebraic

/-!
# Actual quadratic subfields in one ambient field

The concrete quadratic algebra is identified with the intermediate field
generated by a specified square root. Field containment is equivalent to
the expected square-class relation. No class-field object is introduced.
-/

noncomputable section

namespace NormEuclidean.QuadraticRootFields

open QuadraticExtensionNorm
open scoped QuadraticAlgebra IntermediateField

variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]

/-- Evaluate the concrete quadratic algebra at an actual root in the ambient field. -/
def embedding (theta : Kˣ) (r : Ω) (hr : r ^ 2 = algebraMap K Ω (theta : K)) :
    QuadraticAlgebra K (theta : K) 0 →ₐ[K] Ω :=
  QuadraticAlgebra.lift ⟨r, by simpa only [pow_two, Algebra.smul_def, mul_one,
    map_zero, zero_mul, add_zero] using hr⟩

/-- The chosen embedding sends the quadratic generator to the specified root. -/
theorem embedding_omega (theta : Kˣ) (r : Ω)
    (hr : r ^ 2 = algebraMap K Ω (theta : K)) : embedding theta r hr ω = r := by
  simp [embedding, QuadraticAlgebra.lift, QuadraticAlgebra.omega]

/-- The actual image of the quadratic field is the subfield generated by its root. -/
theorem fieldRange_eq_adjoin (theta : Kˣ) (htheta : ¬ IsSquare theta)
    (r : Ω) (hr : r ^ 2 = algebraMap K Ω (theta : K)) :
    letI := quadraticExtensionField theta htheta
    (embedding theta r hr).fieldRange = K⟮r⟯ := by
  letI := quadraticExtensionField theta htheta
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    change embedding theta r hr z ∈ K⟮r⟯
    have he : embedding theta r hr z =
        algebraMap K Ω z.re + algebraMap K Ω z.im * r := by
      simp [embedding, QuadraticAlgebra.lift, Algebra.smul_def]
    rw [he]
    exact (K⟮r⟯).add_mem ((K⟮r⟯).algebraMap_mem z.re)
      ((K⟮r⟯).mul_mem ((K⟮r⟯).algebraMap_mem z.im)
        (IntermediateField.mem_adjoin_simple_self K r))
  · apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact ⟨ω, embedding_omega theta r hr⟩

/-- An actual algebra equivalence with the quadratic subfield in the common ambient field. -/
def equivAdjoin (theta : Kˣ) (htheta : ¬ IsSquare theta)
    (r : Ω) (hr : r ^ 2 = algebraMap K Ω (theta : K)) :
    letI := quadraticExtensionField theta htheta
    QuadraticAlgebra K (theta : K) 0 ≃ₐ[K] K⟮r⟯ := by
  letI := quadraticExtensionField theta htheta
  exact (embedding theta r hr).equivFieldRange.trans
    (IntermediateField.equivOfEq (fieldRange_eq_adjoin theta htheta r hr))

/-- The generated intermediate field is finite-dimensional over the base field. -/
theorem finiteDimensional_adjoin (theta : Kˣ) (htheta : ¬ IsSquare theta)
    (r : Ω) (hr : r ^ 2 = algebraMap K Ω (theta : K)) : FiniteDimensional K K⟮r⟯ := by
  letI := quadraticExtensionField theta htheta
  exact Module.Finite.equiv (equivAdjoin theta htheta r hr).toLinearEquiv

/-- The generated field has actual degree two when the base parameter is nonsquare. -/
theorem finrank_adjoin (theta : Kˣ) (htheta : ¬ IsSquare theta)
    (r : Ω) (hr : r ^ 2 = algebraMap K Ω (theta : K)) : Module.finrank K K⟮r⟯ = 2 := by
  letI := quadraticExtensionField theta htheta
  exact (equivAdjoin theta htheta r hr).toLinearEquiv.finrank_eq.symm.trans
    (QuadraticAlgebra.finrank_eq_two _ _)

/-- The field identification preserves the actual global determinant norm. -/
theorem norm_equivAdjoin (theta : Kˣ) (htheta : ¬ IsSquare theta)
    (r : Ω) (hr : r ^ 2 = algebraMap K Ω (theta : K)) :
    letI := quadraticExtensionField theta htheta
    ∀ z : QuadraticAlgebra K (theta : K) 0,
      Algebra.norm K (equivAdjoin theta htheta r hr z) = Algebra.norm K z := by
  letI := quadraticExtensionField theta htheta
  exact Algebra.norm_eq_of_algEquiv (equivAdjoin theta htheta r hr)

/-- A root of a base square belongs to every intermediate field. -/
theorem root_mem_of_square (eta : Kˣ) (s : Ω)
    (hs : s ^ 2 = algebraMap K Ω (eta : K)) (heta : IsSquare eta)
    (P : IntermediateField K Ω) : s ∈ P := by
  obtain ⟨c, hc⟩ := heta
  have he : s ^ 2 = (algebraMap K Ω (c : K)) ^ 2 := by
    rw [hs, hc, Units.val_mul, map_mul, pow_two]
  rcases (sq_eq_sq_iff_eq_or_eq_neg).mp he with h | h
  · rw [h]
    exact P.algebraMap_mem c
  · rw [h]
    exact P.neg_mem (P.algebraMap_mem c)

/-- The square-class relation puts one actual quadratic root field inside the other. -/
theorem adjoin_le_of_square_or_mul (theta eta : Kˣ) (r s : Ω)
    (hr : r ^ 2 = algebraMap K Ω (theta : K))
    (hs : s ^ 2 = algebraMap K Ω (eta : K))
    (h : IsSquare eta ∨ IsSquare (eta * theta)) : K⟮s⟯ ≤ K⟮r⟯ := by
  apply IntermediateField.adjoin_le_iff.mpr
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  rw [hx]
  change s ∈ K⟮r⟯
  rcases h with h | h
  · exact root_mem_of_square eta s hs h K⟮r⟯
  · have hr0 : r ≠ 0 := by
      intro hz
      have hn := (map_ne_zero (algebraMap K Ω)).mpr theta.ne_zero
      exact hn (by simpa [hz] using hr.symm)
    have hprod : (s * r) ^ 2 = algebraMap K Ω ((eta * theta : Kˣ) : K) := by
      rw [mul_pow, hs, hr, Units.val_mul, map_mul]
    have hm := root_mem_of_square (eta * theta) (s * r) hprod h K⟮r⟯
    have hd : (s * r) / r ∈ K⟮r⟯ :=
      (K⟮r⟯).div_mem hm (IntermediateField.mem_adjoin_simple_self K r)
    rwa [mul_div_cancel_right₀ s hr0] at hd

variable [CharZero K]

/-- Actual quadratic field containment is exactly the two possible base square classes. -/
theorem adjoin_le_iff (theta : Kˣ) (htheta : ¬ IsSquare theta) (eta : Kˣ) (r s : Ω)
    (hr : r ^ 2 = algebraMap K Ω (theta : K))
    (hs : s ^ 2 = algebraMap K Ω (eta : K)) :
    K⟮s⟯ ≤ K⟮r⟯ ↔ IsSquare eta ∨ IsSquare (eta * theta) := by
  constructor
  · intro hle
    letI := quadraticExtensionField theta htheta
    let z : K⟮r⟯ := ⟨s, hle (IntermediateField.mem_adjoin_simple_self K s)⟩
    let e := equivAdjoin theta htheta r hr
    have hz : z ^ 2 = algebraMap K K⟮r⟯ (eta : K) := Subtype.ext hs
    have he : (e.symm z) ^ 2 = algebraMap K (QuadraticAlgebra K (theta : K) 0) (eta : K) := by
      apply e.injective
      rw [map_pow, e.apply_symm_apply, e.commutes, hz]
    apply (QuadraticSquareDescent.square_base_iff theta htheta eta).mp
    apply (GlobalSquare.unit_square_iff _).mpr
    refine ⟨e.symm z, ?_⟩
    change algebraMap K (QuadraticAlgebra K (theta : K) 0) (eta : K) = e.symm z * e.symm z
    simpa only [pow_two] using he.symm
  · exact adjoin_le_of_square_or_mul theta eta r s hr hs

end NormEuclidean.QuadraticRootFields
