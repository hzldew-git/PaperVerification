import NormEuclidean.Maximality
import NormEuclidean.ScalarExtension
import Mathlib.Tactic.Linarith

/-!
Supplementary result retained from reference manuscript. The free-unary finiteness proposition
is absent from reference manuscript; this module is not counted as a current-paper theorem.

# The free unary reduction

These are the arithmetic reductions in the proof of Proposition
`prop:unary-finiteness`. The number-field property has the manuscript's
quantifier over every element of the field, with an integral approximant.
The square form is equivalent to this property. A nonzero integral scalar
multiple of the square form implies it; the converse is not asserted for
an arbitrary scalar. The global finiteness equivalence additionally uses
the norm-ideal bound and finiteness of units modulo squares.
-/

namespace NormEuclidean

open scoped NumberField

variable (K : Type*) [Field K] [NumberField K]

/-- Norm Euclideanity of a number field, exactly as defined immediately
before Proposition `prop:unary-finiteness` in the manuscript. -/
def IsNormEuclideanNumberField : Prop :=
  ∀ x : K, ∃ y : 𝓞 K, |Algebra.norm ℚ (x - (y : K))| < 1

/-- The rank-one integral module inside the number field. -/
def integerModule : Submodule (integerSubring K) K where
  carrier := integerSubring K
  zero_mem' := (integerSubring K).zero_mem
  add_mem' := (integerSubring K).add_mem
  smul_mem' := fun r _ hx => (integerSubring K).mul_mem r.property hx

omit [NumberField K] in
@[simp] theorem mem_integerModule (x : K) :
    x ∈ integerModule K ↔ x ∈ integerSubring K := Iff.rfl

/-- The unary quadratic form with coefficient `a`. -/
noncomputable def unaryForm (a : K) : QuadraticForm K K :=
  a • QuadraticMap.sq

omit [NumberField K] in
@[simp] theorem unaryForm_apply (a x : K) : unaryForm K a x = a * x ^ 2 := by
  simp [unaryForm, pow_two]

omit [NumberField K] in
theorem unaryForm_anisotropic {a : K} (ha : a ≠ 0) :
    (unaryForm K a).Anisotropic := by
  intro x hx
  simpa [ha] using hx

/-- Squaring the norm does not change the strict approximation threshold. -/
theorem fieldAbsNorm_sq (x : K) : fieldAbsNorm K (x ^ 2) = (fieldAbsNorm K x) ^ 2 := by
  simp [pow_two, fieldAbsNorm_mul]

/-- A nonzero integral coefficient cannot improve the norm approximation
threshold beyond the field's own threshold. -/
theorem normEuclideanNumberField_of_unary
    {a : K} (ha : a ∈ integerSubring K) (ha0 : a ≠ 0)
    (hE : HasNumberFieldApproximation (unaryForm K a) (integerModule K)) :
    IsNormEuclideanNumberField K := by
  intro x
  obtain ⟨y, hy, happ⟩ := hE x
  refine ⟨⟨y, hy⟩, ?_⟩
  have ha1 : 1 ≤ fieldAbsNorm K a :=
    (numberFieldNorm K).one_le_of_integral ha ha0
  have hy0 := fieldAbsNorm_nonneg K (x - y)
  change fieldAbsNorm K (unaryForm K a (x - y)) < 1 at happ
  rw [unaryForm_apply, fieldAbsNorm_mul, fieldAbsNorm_sq] at happ
  have hsq0 : 0 ≤ (fieldAbsNorm K (x - y)) ^ 2 := sq_nonneg _
  have hsq : (fieldAbsNorm K (x - y)) ^ 2 < 1 :=
    lt_of_le_of_lt (le_mul_of_one_le_left hsq0 ha1) happ
  change fieldAbsNorm K (x - y) < 1
  nlinarith

/-- The free unary square lattice is norm Euclidean exactly when its
number field is norm Euclidean. No total-reality hypothesis is needed for
this arithmetic equivalence. -/
theorem square_normEuclidean_iff_numberField :
    HasNumberFieldApproximation (unaryForm K 1) (integerModule K) ↔
      IsNormEuclideanNumberField K := by
  constructor
  · exact normEuclideanNumberField_of_unary K (integerSubring K).one_mem one_ne_zero
  · intro hE x
    obtain ⟨y, hy⟩ := hE x
    refine ⟨y, y.property, ?_⟩
    change fieldAbsNorm K (unaryForm K 1 (x - (y : K))) < 1
    rw [unaryForm_apply, one_mul, fieldAbsNorm_sq]
    have h0 := fieldAbsNorm_nonneg K (x - (y : K))
    change fieldAbsNorm K (x - (y : K)) < 1 at hy
    nlinarith

/-- An integral nonzero norm-Euclidean unary coefficient exists exactly
when the number field is norm Euclidean. -/
theorem exists_unary_normEuclidean_iff_numberField :
    (∃ a : K, a ∈ integerSubring K ∧ a ≠ 0 ∧
      HasNumberFieldApproximation (unaryForm K a) (integerModule K)) ↔
    IsNormEuclideanNumberField K := by
  constructor
  · rintro ⟨a, ha, ha0, hE⟩
    exact normEuclideanNumberField_of_unary K ha ha0 hE
  · intro hE
    exact ⟨1, (integerSubring K).one_mem, one_ne_zero,
      (square_normEuclidean_iff_numberField K).mpr hE⟩

omit [NumberField K] in
/-- The integer module is generated by `1`. -/
theorem integerModule_eq_span_one :
    integerModule K = Submodule.span (integerSubring K) {(1 : K)} := by
  ext x
  rw [Submodule.mem_span_singleton]
  constructor
  · intro hx
    exact ⟨⟨x, hx⟩, by simp [Subring.smul_def]⟩
  · rintro ⟨a, rfl⟩
    simpa only [Subring.smul_def, smul_eq_mul, mul_one, mem_integerModule] using a.property

omit [NumberField K] in
/-- Its span over the number field is the entire one-dimensional space. -/
theorem integerModule_full :
    Submodule.span K (integerModule K : Set K) = ⊤ := by
  apply top_unique
  intro x _
  have h1 : (1 : K) ∈ Submodule.span K (integerModule K : Set K) :=
    Submodule.subset_span (integerSubring K).one_mem
  simpa using (Submodule.span K (integerModule K : Set K)).smul_mem x h1

/-- The integer module is a free rank-one module, with its explicit coordinate
isomorphism. -/
def integerModuleEquiv : integerSubring K ≃ₗ[integerSubring K] integerModule K where
  toFun a := ⟨a, a.property⟩
  invFun a := ⟨a, a.property⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

instance integerModule_free : Module.Free (integerSubring K) (integerModule K) :=
  Module.Free.of_equiv (integerModuleEquiv K)

omit [NumberField K] in
theorem integerModule_finrank :
    Module.finrank (integerSubring K) (integerModule K) = 1 := by
  rw [← (integerModuleEquiv K).finrank_eq]
  exact Module.finrank_self _

/-- The actual finite, full, integral unary lattice for an integral
coefficient; it is not merely a set of coordinate approximants. -/
def unaryLattice (a : K) (ha : a ∈ integerSubring K) :
    Lattice (integerSubring K) (unaryForm K a) where
  carrier := integerModule K
  finite := by rw [integerModule_eq_span_one]; exact Submodule.fg_span_singleton _
  full := integerModule_full K
  integral x hx := by
    rw [unaryForm_apply]
    exact (integerSubring K).mul_mem ha ((integerSubring K).pow_mem hx 2)

variable {V : Type*} [AddCommGroup V] [Module K V]

/-- A free unary lattice with a supplied rank-one module equivalence yields
a norm-Euclidean number field. The coefficient is extracted from a basis
vector; its integrality and nonvanishing are proved from the lattice and
anisotropy hypotheses. -/
theorem normEuclideanNumberField_of_freeUnary_equiv
    (Q : QuadraticForm K V) (L : Lattice (integerSubring K) Q)
    (hA : Q.Anisotropic) (hE : HasNumberFieldApproximation Q L.carrier)
    (e : integerSubring K ≃ₗ[integerSubring K] L.carrier) :
    IsNormEuclideanNumberField K := by
  let f := (integerModuleEquiv K).symm.trans e
  let g := ScalarExtension.ambientEquiv (integerModule K) L.carrier
    (integerModule_full K) L.full f
  have hg (y : integerModule K) : g (y : K) = (f y : V) :=
    ScalarExtension.ambientEquiv_apply _ _ _ _ _ y
  have hg1 : g 1 = (e 1 : V) := hg ⟨1, (integerSubring K).one_mem⟩
  let a := Q (g 1)
  have ha : a ∈ integerSubring K := by
    rw [show a = Q (e 1 : V) by dsimp [a]; rw [hg1]]
    exact L.integral _ (e 1).property
  have ha0 : a ≠ 0 := by
    intro h
    have hz : g 1 = 0 := hA _ h
    have he : (1 : K) = 0 := g.injective (hz.trans g.map_zero.symm)
    exact one_ne_zero he
  apply normEuclideanNumberField_of_unary K ha ha0
  intro x
  obtain ⟨u, hu, happ⟩ := hE (g x)
  let y : integerModule K := f.symm ⟨u, hu⟩
  have hgy : g (y : K) = u := (hg y).trans (by simp [y])
  refine ⟨y, y.property, ?_⟩
  have hform (t : K) : Q (g t) = unaryForm K a t := by
    have hgt : g t = t • g 1 := by rw [← g.map_smul]; simp
    rw [hgt, Q.map_smul, unaryForm_apply]
    simp only [smul_eq_mul]
    dsimp [a]
    ring
  rw [← hgy] at happ
  have hsub : g x - g (y : K) = g (x - y) := (map_sub g x (y : K)).symm
  rw [hsub, hform] at happ
  exact happ

/-- The same reduction with the manuscript's literal freeness and unary
rank hypotheses, rather than a supplied choice of coordinates. -/
theorem normEuclideanNumberField_of_freeUnary
    (Q : QuadraticForm K V) (L : Lattice (integerSubring K) Q)
    [Module.Free (integerSubring K) L.carrier]
    (hrank : Module.finrank (integerSubring K) L.carrier = 1)
    (hA : Q.Anisotropic) (hE : HasNumberFieldApproximation Q L.carrier) :
    IsNormEuclideanNumberField K := by
  letI : Module.Finite (integerSubring K) L.carrier := Module.Finite.iff_fg.mpr L.finite
  let b := (Module.finBasis (integerSubring K) L.carrier).reindex (finCongr hrank)
  let e := b.equivFun.trans (LinearEquiv.funUnique (Fin 1) (integerSubring K) _)
  exact normEuclideanNumberField_of_freeUnary_equiv K Q L hA hE e.symm

/-- Over a fixed number field, existence of a free anisotropic
norm-Euclidean unary integral lattice is equivalent to norm Euclideanity
of the field. The ambient space on the existence side is its standard
one-dimensional model `K`; arbitrary free unary lattices are covered by
`normEuclideanNumberField_of_freeUnary` above. -/
theorem exists_freeUnary_normEuclidean_iff_numberField :
    (∃ (Q : QuadraticForm K K) (L : Lattice (integerSubring K) Q),
      Module.Free (integerSubring K) L.carrier ∧
      Module.finrank (integerSubring K) L.carrier = 1 ∧
      Q.Anisotropic ∧ HasNumberFieldApproximation Q L.carrier) ↔
    IsNormEuclideanNumberField K := by
  constructor
  · rintro ⟨Q, L, hfree, hrank, hA, hE⟩
    letI := hfree
    exact normEuclideanNumberField_of_freeUnary K Q L hrank hA hE
  · intro hE
    refine ⟨unaryForm K 1, unaryLattice K 1 (integerSubring K).one_mem,
      integerModule_free K, integerModule_finrank K,
      unaryForm_anisotropic K one_ne_zero, ?_⟩
    exact (square_normEuclidean_iff_numberField K).mpr hE

end NormEuclidean
