import NormEuclidean.BinaryPlaceDensity

/-!
# Volume-normalized odd binary factors

For the primitive Gram model `diag(1,-d)`, the scale ideal is the unit
ideal and the volume ideal is `(d)`. Dividing the proved Gram self-density
by its local volume index gives `1-chi/q` in the unimodular case and `2`
in the positive-valuation case. The complete global class-sum/product
identity, and its dyadic measure normalization, are not asserted here.
-/

noncomputable section

namespace NormEuclidean.BinaryLocalMassFactors

open BinaryCongruenceDensity UnramifiedBinaryDensity IsLocalRing

variable {R : Type*} [CommRing R]

/-- The scale ideal generated by the actual Gram entries is the unit ideal. -/
theorem gram_scale (d : R) :
    Ideal.span (Set.range (fun p : Fin 2 × Fin 2 ↦ gram d p.1 p.2)) = ⊤ := by
  apply Ideal.eq_top_of_isUnit_mem _ _ isUnit_one
  apply Ideal.subset_span
  exact ⟨(0, 0), rfl⟩

/-- The actual Gram determinant generates exactly the parameter ideal. -/
theorem gram_volume (d : R) :
    Ideal.span ({(gram d).det} : Set R) = Ideal.span ({d} : Set R) := by
  have he : (gram d).det = -d := by simp [gram, Matrix.det_fin_two]
  rw [he, Ideal.span_singleton_neg]

section Local

variable (R) [IsLocalRing R]

/-- The finite-level Gram density divided by the actual local volume index. -/
def factor (d : R) (n : ℕ) : ℝ :=
  levelDensity R d n / Nat.card (R ⧸ Ideal.span ({(gram d).det} : Set R))

/-- The unit parameter has volume index one, so no correction is needed. -/
theorem factor_unimodular (d : R) (hd : IsUnit d) (n : ℕ) :
    factor R d n = levelDensity R d n := by
  unfold factor
  rw [gram_volume, Ideal.span_singleton_eq_top.mpr hd]
  simp

end Local

variable (R) [IsDomain R] [IsDiscreteValuationRing R] [Finite (ResidueField R)]

/-- Every positive-valuation odd factor is exactly two after the actual
volume correction, at every level above the parameter valuation. -/
theorem factor_positive_valuation (d : R) (h2 : IsUnit (2 : R)) (r n : ℕ) (hr : 0 < r)
    (hd : Ideal.span ({d} : Set R) = maximalIdeal R ^ r) : factor R d (r + n) = 2 := by
  unfold factor
  rw [gram_volume, RamifiedBinaryDensity.ramified_level R d h2 r n hr hd, hd]
  have hc : Nat.card (R ⧸ maximalIdeal R ^ r) = Nat.card (ResidueField R) ^ r :=
    cardQuot_pow_of_prime (IsDiscreteValuationRing.not_a_field R)
  rw [hc, Nat.cast_pow, mul_div_cancel_right₀]
  exact pow_ne_zero _ (by exact_mod_cast (Nat.card_pos : 0 < Nat.card (ResidueField R)).ne')

section Places

open IsDedekindDomain Bong.NumberFieldCompletion BinaryPlaceDensity
open scoped NumberField

variable {K : Type*} [Field K] [NumberField K]

/-- The volume-normalized good factor at an actual number-field place. -/
theorem place_unimodular (p : HeightOneSpectrum (𝓞 K))
    (hp : (2 : 𝓞 K) ∉ p.asIdeal) (d : integerRing p) (hd : IsUnit d) (n : ℕ) :
    factor (integerRing p) d n =
      1 - (character p d : ℝ) / Ideal.absNorm p.asIdeal := by
  rw [factor_unimodular _ d hd n]
  exact unimodular_factor p hp d hd n

/-- The positive-valuation local factor is two at actual odd number-field places. -/
theorem place_positive_valuation (p : HeightOneSpectrum (𝓞 K))
    (hp : (2 : 𝓞 K) ∉ p.asIdeal) (d : integerRing p) (r n : ℕ) (hr : 0 < r)
    (hd : Ideal.span ({d} : Set (integerRing p)) = maximalIdeal (integerRing p) ^ r) :
    factor (integerRing p) d (r + n) = 2 :=
  factor_positive_valuation _ d (two_isUnit p hp) r n hr hd

/-- The finite positive-valuation part of the odd local product is exactly
two to the number of its places; each factor comes from actual congruence counts. -/
theorem finite_positive_valuation_product (S : Finset (HeightOneSpectrum (𝓞 K)))
    (d : (p : HeightOneSpectrum (𝓞 K)) → integerRing p)
    (r n : HeightOneSpectrum (𝓞 K) → ℕ)
    (hodd : ∀ p ∈ S, (2 : 𝓞 K) ∉ p.asIdeal) (hr : ∀ p ∈ S, 0 < r p)
    (hd : ∀ p ∈ S, Ideal.span ({d p} : Set (integerRing p)) =
      maximalIdeal (integerRing p) ^ r p) :
    ∏ p ∈ S, factor (integerRing p) (d p) (r p + n p) = (2 : ℝ) ^ S.card := by
  calc
    _ = ∏ _p ∈ S, (2 : ℝ) := Finset.prod_congr rfl fun p hp ↦
      place_positive_valuation p (hodd p hp) (d p) (r p) (n p) (hr p hp) (hd p hp)
    _ = _ := by simp

end Places

end NormEuclidean.BinaryLocalMassFactors
