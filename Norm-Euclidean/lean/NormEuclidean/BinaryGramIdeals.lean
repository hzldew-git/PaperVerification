import NormEuclidean.PrimitiveBinaryNormalForm
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Actual scale and determinant ideals of binary Gram matrices

Integral basis changes preserve both ideals. Over a PID, a nonzero Gram
matrix admits a constructed scalar primitive part. Its determinant ideal
satisfies volume(G)=scale(G)^2*volume(primitive part).
-/

noncomputable section

namespace NormEuclidean.BinaryGramIdeals

open scoped Matrix

variable {R : Type*} [CommRing R]

/-- The ideal generated by all actual Gram entries. -/
def scale (G : Matrix (Fin 2) (Fin 2) R) : Ideal R :=
  Ideal.span (Set.range (fun p : Fin 2 × Fin 2 ↦ G p.1 p.2))

/-- The principal ideal generated by the actual Gram determinant. -/
def volume (G : Matrix (Fin 2) (Fin 2) R) : Ideal R := Ideal.span ({G.det} : Set R)

private theorem entry_mem (G : Matrix (Fin 2) (Fin 2) R) (i j : Fin 2) :
    G i j ∈ scale G := Ideal.subset_span ⟨(i, j), rfl⟩

/-- A binary determinant belongs to the ideal generated by its actual entries. -/
theorem det_mem_scale (G : Matrix (Fin 2) (Fin 2) R) : G.det ∈ scale G := by
  rw [Matrix.det_fin_two]
  exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ (entry_mem G 0 0))
    (Ideal.mul_mem_right _ _ (entry_mem G 0 1))

/-- A unit determinant makes the actual entry ideal the unit ideal. -/
theorem primitive_of_unit_det (G : Matrix (Fin 2) (Fin 2) R) (h : IsUnit G.det) :
    PrimitiveBinaryNormalForm.Primitive G :=
  Ideal.eq_top_of_isUnit_mem _ (det_mem_scale G) h

/-- Any integral change of coordinates can only decrease the scale ideal. -/
theorem scale_congruence_le (G P : Matrix (Fin 2) (Fin 2) R) :
    scale (P.transpose * G * P) ≤ scale G := by
  apply Ideal.span_le.mpr
  rintro _ ⟨p, rfl⟩
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  apply Ideal.sum_mem
  intro k _
  apply Ideal.mul_mem_right
  apply Ideal.sum_mem
  intro l _
  exact Ideal.mul_mem_left _ _ (entry_mem G l k)

/-- Invertible integral basis changes preserve the actual scale ideal. -/
theorem scale_basis (G : Matrix (Fin 2) (Fin 2) R)
    (P : (Matrix (Fin 2) (Fin 2) R)ˣ) : scale (P.val.transpose * G * P.val) = scale G := by
  apply le_antisymm (scale_congruence_le G P.val)
  have h := scale_congruence_le (P.val.transpose * G * P.val)
    (P⁻¹ : (Matrix (Fin 2) (Fin 2) R)ˣ).val
  have ht : (P⁻¹ : (Matrix (Fin 2) (Fin 2) R)ˣ).val.transpose * P.val.transpose = 1 := by
    rw [← Matrix.transpose_mul, Units.mul_inv, Matrix.transpose_one]
  have he : (P⁻¹ : (Matrix (Fin 2) (Fin 2) R)ˣ).val.transpose *
      (P.val.transpose * G * P.val) * (P⁻¹ : (Matrix (Fin 2) (Fin 2) R)ˣ).val = G := by
    calc
      _ = ((P⁻¹ : (Matrix (Fin 2) (Fin 2) R)ˣ).val.transpose * P.val.transpose) *
        G * (P.val * (P⁻¹ : (Matrix (Fin 2) (Fin 2) R)ˣ).val) := by simp [Matrix.mul_assoc]
      _ = G := by rw [ht, Units.mul_inv, Matrix.one_mul, Matrix.mul_one]
  rwa [he] at h

/-- Invertible integral basis changes preserve the determinant ideal. -/
theorem volume_basis (G : Matrix (Fin 2) (Fin 2) R)
    (P : (Matrix (Fin 2) (Fin 2) R)ˣ) : volume (P.val.transpose * G * P.val) = volume G := by
  have hu : IsUnit P.val.det := (Matrix.isUnit_iff_isUnit_det _).mp P.isUnit
  unfold volume
  rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose,
    Ideal.span_singleton_mul_right_unit hu, Ideal.span_singleton_mul_left_unit hu]

/-- Scalar multiplication of all entries multiplies the actual scale ideal. -/
theorem scale_smul (G : Matrix (Fin 2) (Fin 2) R) (s : R) :
    scale (s • G) = Ideal.span ({s} : Set R) * scale G := by
  unfold scale
  rw [Ideal.span_mul_span]
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_mul, Set.mem_singleton_iff]
  constructor
  · rintro ⟨p, rfl⟩
    exact ⟨s, rfl, G p.1 p.2, ⟨p, rfl⟩, rfl⟩
  · rintro ⟨t, rfl, y, ⟨p, rfl⟩, rfl⟩
    exact ⟨p, rfl⟩

/-- Binary volume scales by the square of the scalar ideal. -/
theorem volume_smul (G : Matrix (Fin 2) (Fin 2) R) (s : R) :
    volume (s • G) = Ideal.span ({s} : Set R) ^ 2 * volume G := by
  unfold volume
  rw [Matrix.det_smul, Fintype.card_fin, Ideal.span_singleton_pow,
    Ideal.span_singleton_mul_span_singleton]

/-- Unit rescaling preserves the determinant ideal. -/
theorem volume_unit (G : Matrix (Fin 2) (Fin 2) R) (a : Rˣ) :
    volume ((a : R) • G) = volume G := by
  unfold volume
  rw [Matrix.det_smul, Fintype.card_fin, Ideal.span_singleton_mul_left_unit (a.isUnit.pow 2)]

/-- The norm model has determinant ideal (d). -/
theorem volume_norm (d : R) :
    volume (BinaryCongruenceDensity.gram d) = Ideal.span ({d} : Set R) := by
  unfold volume
  simp [BinaryCongruenceDensity.gram, Matrix.det_fin_two, Ideal.span_singleton_neg]

/-- A constructed norm basis identifies the actual determinant ideal. -/
theorem volume_of_norm_basis (G : Matrix (Fin 2) (Fin 2) R)
    (P : (Matrix (Fin 2) (Fin 2) R)ˣ) (a : Rˣ) (d : R)
    (h : P.val.transpose * G * P.val = (a : R) • BinaryCongruenceDensity.gram d) :
    volume G = Ideal.span ({d} : Set R) := by
  rw [← volume_basis G P, h, volume_unit, volume_norm]

section PID

variable [IsDomain R] [IsPrincipalIdealRing R]

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- A nonzero determinant implies that the actual scale ideal is nonzero. -/
theorem scale_ne_bot (G : Matrix (Fin 2) (Fin 2) R) (hd : G.det ≠ 0) : scale G ≠ ⊥ := by
  intro he
  have hzero : G = 0 := by
    ext i j
    have h := entry_mem G i j
    rw [he, Submodule.mem_bot] at h
    exact h
  exact hd (by simp [hzero])

/-- A primitive integral part is constructed from a generator of the actual scale ideal. -/
theorem exists_primitive_part (G : Matrix (Fin 2) (Fin 2) R) (hd : G.det ≠ 0) :
    ∃ (s : R) (H : Matrix (Fin 2) (Fin 2) R), s ≠ 0 ∧
      G = s • H ∧ scale G = Ideal.span ({s} : Set R) ∧
      PrimitiveBinaryNormalForm.Primitive H := by
  let s := Submodule.IsPrincipal.generator (scale G)
  have hs : Ideal.span ({s} : Set R) = scale G := Ideal.span_singleton_generator _
  have hs0 : s ≠ 0 := by
    intro hz
    apply scale_ne_bot G hd
    rw [← hs, hz]
    simp
  have hdiv (i j : Fin 2) : ∃ x, G i j = s * x := by
    have h := entry_mem G i j
    rw [← hs, Ideal.mem_span_singleton] at h
    obtain ⟨x, hx⟩ := h
    exact ⟨x, hx⟩
  choose H0 hH using hdiv
  let H : Matrix (Fin 2) (Fin 2) R := fun i j ↦ H0 i j
  have he : G = s • H := by ext i j; exact hH i j
  have hp : scale H = ⊤ := by
    apply (Ideal.span_singleton_mul_right_inj hs0).mp
    rw [← scale_smul, ← he, hs, Ideal.mul_top]
  exact ⟨s, H, hs0, he, hs.symm, hp⟩

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- The primitive determinant ideal is the scale-corrected determinant data. -/
theorem primitive_volume (G H : Matrix (Fin 2) (Fin 2) R) (s : R)
    (hG : G = s • H) (hs : scale G = Ideal.span ({s} : Set R)) :
    volume G = scale G ^ 2 * volume H := by
  calc
    _ = volume (s • H) := congrArg volume hG
    _ = Ideal.span ({s} : Set R) ^ 2 * volume H := volume_smul H s
    _ = _ := by rw [hs]

end PID

end NormEuclidean.BinaryGramIdeals
