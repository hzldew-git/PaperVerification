import NormEuclidean.NumberField
import Mathlib.RingTheory.Ideal.Norm.AbsNorm

/-!
# The integral norm ideal

The ideal is generated by the actual values of the quadratic form on the
integral lattice; no chosen basis or freeness over the ring of integers is used.
-/

namespace NormEuclidean

open scoped NumberField

variable {K V : Type*} [Field K] [NumberField K] [AddCommGroup V] [Module K V]
variable {Q : QuadraticForm K V}

namespace Lattice

/-- The quadratic value of an integral lattice vector, as an algebraic integer. -/
def normValue (L : Lattice (integerSubring K) Q) (v : L.carrier) : 𝓞 K :=
  ⟨Q v, L.integral v v.property⟩

/-- The genuine integral norm ideal, generated by all values `Q(v)` for `v ∈ L`. -/
def normIdeal (L : Lattice (integerSubring K) Q) : Ideal (𝓞 K) :=
  Ideal.span (Set.range L.normValue)

omit [NumberField K] in
theorem normValue_mem_normIdeal (L : Lattice (integerSubring K) Q) (v : L.carrier) :
    L.normValue v ∈ L.normIdeal :=
  Ideal.subset_span ⟨v, rfl⟩

omit [NumberField K] in
@[simp] theorem coe_normValue (L : Lattice (integerSubring K) Q) (v : L.carrier) :
    (L.normValue v : K) = Q v := rfl

theorem normIdeal_absNorm_le (L : Lattice (integerSubring K) Q)
    (v : L.carrier) (hv : Q v ≠ 0) :
    (Ideal.absNorm L.normIdeal : ℚ) ≤ fieldAbsNorm K (Q v) := by
  have hv' : L.normValue v ≠ 0 := fun h => hv (congrArg ((↑) : 𝓞 K → K) h)
  have hpos : 0 < (Algebra.norm ℤ (L.normValue v)).natAbs := by
    exact Int.natAbs_pos.mpr (Algebra.norm_ne_zero_iff.mpr hv')
  have hdvd : Ideal.absNorm L.normIdeal ∣ (Algebra.norm ℤ (L.normValue v)).natAbs := by
    rw [← Ideal.absNorm_span_singleton]
    exact Ideal.absNorm_dvd_absNorm_of_le
      ((Ideal.span_singleton_le_iff_mem _).mpr (L.normValue_mem_normIdeal v))
  have hle := Nat.le_of_dvd hpos hdvd
  have heq : ((Algebra.norm ℤ (L.normValue v)).natAbs : ℚ) = fieldAbsNorm K (Q v) := by
    rw [← integralNormMeasure_coe K]
    exact integralNormMeasure_spec K (Q v) (L.integral v v.property)
  rw [← heq]
  exact_mod_cast hle

end Lattice
end NormEuclidean
