import NormEuclidean.NormIdeal
import NormEuclidean.QuadraticRescaling

/-!
# Scale ideals and doubling

The scale is the fractional ideal generated by the half-polar bilinear form,
with convention `B(x, x) = Q(x)`. The integer ring need not contain `1 / 2`.
The polar values themselves generate an integral ideal, which is exactly the
scale after doubling the quadratic form.

The span arguments follow the general algebraic pattern in
`Bong/Lattice/Ideals.lean`; no dyadic or local-field hypotheses are used here.
-/

namespace NormEuclidean

open QuadraticMap
open scoped NumberField nonZeroDivisors Pointwise

variable {K V : Type*} [Field K] [NumberField K] [AddCommGroup V] [Module K V]
variable {Q : QuadraticForm K V}

/-- The associated symmetric bilinear form, normalized by `B(x, x) = Q(x)`. -/
noncomputable def halfPolar (Q : QuadraticForm K V) : LinearMap.BilinForm K V :=
  (2 : K)⁻¹ • Q.polarBilin

omit [NumberField K] in
@[simp] theorem halfPolar_apply (Q : QuadraticForm K V) (x y : V) :
    halfPolar Q x y = (2 : K)⁻¹ * polar Q x y := rfl

@[simp] theorem halfPolar_self (Q : QuadraticForm K V) (x : V) :
    halfPolar Q x x = Q x := by
  simp [halfPolar_apply, Q.polar_self, nsmul_eq_mul]

theorem two_mul_halfPolar (Q : QuadraticForm K V) (x y : V) :
    2 * halfPolar Q x y = polar Q x y := by
  simp [halfPolar_apply]

omit [NumberField K] in
theorem halfPolar_comm (Q : QuadraticForm K V) (x y : V) :
    halfPolar Q x y = halfPolar Q y x := by
  simp only [halfPolar_apply, polar_comm Q x y]

@[simp] theorem halfPolar_smul (a : K) (Q : QuadraticForm K V) (x y : V) :
    halfPolar (a • Q) x y = a * halfPolar Q x y := by
  simp only [halfPolar_apply, polar, QuadraticMap.smul_apply, smul_eq_mul]
  ring

namespace Lattice

/-- The polar value on two lattice vectors, as an algebraic integer. -/
def polarValue (L : Lattice (integerSubring K) Q) (p : L.carrier × L.carrier) : 𝓞 K :=
  L.normValue (p.1 + p.2) - L.normValue p.1 - L.normValue p.2

omit [NumberField K] in
@[simp] theorem coe_polarValue (L : Lattice (integerSubring K) Q)
    (p : L.carrier × L.carrier) : (L.polarValue p : K) = polar Q p.1 p.2 := rfl

/-- The `𝓞 K`-span of the associated bilinear pairings on the lattice. -/
noncomputable def scaleSubmodule (L : Lattice (integerSubring K) Q) : Submodule (𝓞 K) K :=
  Submodule.span (𝓞 K) (Set.range fun p : L.carrier × L.carrier ↦ halfPolar Q p.1 p.2)

/-- Multiplication by `2` clears the denominator of every scale generator. -/
theorem scaleSubmodule_isFractional (L : Lattice (integerSubring K) Q) :
    IsFractional (𝓞 K)⁰ L.scaleSubmodule := by
  rw [scaleSubmodule, FractionalIdeal.isFractional_span_iff]
  refine ⟨2, mem_nonZeroDivisors_iff_ne_zero.mpr (by norm_num), ?_⟩
  rintro _ ⟨p, rfl⟩
  refine ⟨L.polarValue p, ?_⟩
  change polar Q p.1 p.2 = 2 * halfPolar Q p.1 p.2
  exact (two_mul_halfPolar Q p.1 p.2).symm

/-- The genuine scale fractional ideal; no freeness or classic integrality is assumed. -/
noncomputable def scaleIdeal (L : Lattice (integerSubring K) Q) : FractionalIdeal (𝓞 K)⁰ K :=
  ⟨L.scaleSubmodule, L.scaleSubmodule_isFractional⟩

@[simp] theorem coe_scaleIdeal (L : Lattice (integerSubring K) Q) :
    (L.scaleIdeal : Submodule (𝓞 K) K) = L.scaleSubmodule := rfl

theorem halfPolar_mem_scaleIdeal (L : Lattice (integerSubring K) Q)
    (x y : L.carrier) : halfPolar Q x y ∈ L.scaleIdeal :=
  Submodule.subset_span ⟨(x, y), rfl⟩

/-- The norm ideal sits inside the scale because every norm is a diagonal pairing. -/
theorem normIdeal_le_scaleIdeal (L : Lattice (integerSubring K) Q) :
    (L.normIdeal : FractionalIdeal (𝓞 K)⁰ K) ≤ L.scaleIdeal := by
  change IsLocalization.coeSubmodule K L.normIdeal ≤ L.scaleSubmodule
  rw [normIdeal, IsLocalization.coeSubmodule_span, Submodule.span_le]
  rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
  exact halfPolar_self Q x ▸ L.halfPolar_mem_scaleIdeal x x

omit [NumberField K] in
theorem polarValue_mem_normIdeal (L : Lattice (integerSubring K) Q)
    (p : L.carrier × L.carrier) : L.polarValue p ∈ L.normIdeal :=
  L.normIdeal.sub_mem (L.normIdeal.sub_mem (L.normValue_mem_normIdeal (p.1 + p.2))
    (L.normValue_mem_normIdeal p.1)) (L.normValue_mem_normIdeal p.2)

/-- The polar ideal is the integral scale of the doubled form. -/
def doubledScaleIdeal (L : Lattice (integerSubring K) Q) : Ideal (𝓞 K) :=
  Ideal.span (Set.range L.polarValue)

omit [NumberField K] in
theorem polarValue_mem_doubledScaleIdeal (L : Lattice (integerSubring K) Q)
    (p : L.carrier × L.carrier) : L.polarValue p ∈ L.doubledScaleIdeal :=
  Ideal.subset_span ⟨p, rfl⟩

omit [NumberField K] in
/-- Polarization proves `2 s(L) ⊆ n(L)` at the level of integral generators. -/
theorem doubledScaleIdeal_le_normIdeal (L : Lattice (integerSubring K) Q) :
    L.doubledScaleIdeal ≤ L.normIdeal := by
  rw [doubledScaleIdeal, Ideal.span_le]
  rintro _ ⟨p, rfl⟩
  exact L.polarValue_mem_normIdeal p

/-- Common integral rescaling multiplies the scale fractional ideal by `(a)`. -/
theorem scaleIdeal_rescale (L : Lattice (integerSubring K) Q)
    (a : integerSubring K) :
    (L.rescale a).scaleIdeal = FractionalIdeal.spanSingleton (𝓞 K)⁰ (a : K) *
      L.scaleIdeal := by
  apply FractionalIdeal.coeToSubmodule_injective
  dsimp only
  rw [FractionalIdeal.coe_mul, FractionalIdeal.coe_spanSingleton,
    coe_scaleIdeal, coe_scaleIdeal, Submodule.span_singleton_mul, scaleSubmodule,
    scaleSubmodule, Submodule.smul_span, Set.smul_set_range]
  congr 1
  apply congrArg Set.range
  funext p
  exact halfPolar_smul (a : K) Q p.1 p.2

@[simp] theorem scaleIdeal_double (L : Lattice (integerSubring K) Q) :
    (L.rescale 2).scaleIdeal = FractionalIdeal.spanSingleton (𝓞 K)⁰ (2 : K) *
      L.scaleIdeal := by
  convert L.scaleIdeal_rescale 2 using 1
  norm_cast

/-- The actual integral polar ideal equals the fractional scale of `2 Q`. -/
theorem coe_doubledScaleIdeal (L : Lattice (integerSubring K) Q) :
    (L.doubledScaleIdeal : FractionalIdeal (𝓞 K)⁰ K) =
      (L.rescale 2).scaleIdeal := by
  apply FractionalIdeal.coeToSubmodule_injective
  dsimp only
  rw [FractionalIdeal.coe_coeIdeal, doubledScaleIdeal,
    IsLocalization.coeSubmodule_span, coe_scaleIdeal, scaleSubmodule,
    ← Set.range_comp]
  congr 1
  apply congrArg Set.range
  funext p
  change polar Q p.1 p.2 = halfPolar ((2 : K) • Q) p.1 p.2
  rw [halfPolar_smul, two_mul_halfPolar]

/-- The scale of the doubled form is `2 s(L)`, an integral ideal contained in `n(L)`. -/
theorem two_scaleIdeal_le_normIdeal (L : Lattice (integerSubring K) Q) :
    FractionalIdeal.spanSingleton (𝓞 K)⁰ (2 : K) * L.scaleIdeal ≤
      (L.normIdeal : FractionalIdeal (𝓞 K)⁰ K) := by
  rw [← L.scaleIdeal_double, ← L.coe_doubledScaleIdeal]
  exact (FractionalIdeal.coeIdeal_le_coeIdeal K).mpr L.doubledScaleIdeal_le_normIdeal

/-- The integral scale after doubling contains `2 n(L)`. -/
theorem two_normIdeal_le_doubledScaleIdeal (L : Lattice (integerSubring K) Q) :
    Ideal.span {(2 : 𝓞 K)} * L.normIdeal ≤ L.doubledScaleIdeal := by
  apply (FractionalIdeal.coeIdeal_le_coeIdeal K).mp
  rw [FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_span_singleton,
    L.coe_doubledScaleIdeal, L.scaleIdeal_rescale]
  exact mul_le_mul_right L.normIdeal_le_scaleIdeal _

/-- Doubling makes the scale integral even if the original scale is fractional. -/
theorem doubled_scaleIdeal_le_one (L : Lattice (integerSubring K) Q) :
    (L.rescale 2).scaleIdeal ≤ 1 := by
  rw [← L.coe_doubledScaleIdeal]
  exact FractionalIdeal.coeIdeal_le_one

/-- The scale bound needed to apply a finiteness theorem after doubling.
This holds without anisotropy, positive definiteness, or a nonzero-rank assumption. -/
theorem doubledScaleIdeal_absNorm_le (L : Lattice (integerSubring K) Q) :
    Ideal.absNorm L.doubledScaleIdeal ≤
      2 ^ Module.finrank ℚ K * Ideal.absNorm L.normIdeal := by
  by_cases hzero : L.normIdeal = ⊥
  · have hs : L.doubledScaleIdeal = ⊥ := le_bot_iff.mp (hzero ▸
        L.doubledScaleIdeal_le_normIdeal)
    simp [hs, hzero]
  · have hnormpos : 0 < Ideal.absNorm L.normIdeal :=
      Nat.pos_of_ne_zero (mt Ideal.absNorm_eq_zero_iff.mp hzero)
    have htwo : Ideal.absNorm (Ideal.span {(2 : 𝓞 K)}) = 2 ^ Module.finrank ℚ K := by
      rw [show (2 : 𝓞 K) = ((2 : ℕ) : 𝓞 K) from rfl, Ideal.absNorm_span_natCast,
        NumberField.RingOfIntegers.rank]
    have hpos : 0 < Ideal.absNorm (Ideal.span {(2 : 𝓞 K)} * L.normIdeal) := by
      rw [map_mul, htwo]
      exact Nat.mul_pos (pow_pos (by decide) _) hnormpos
    have hle := Nat.le_of_dvd hpos
      (Ideal.absNorm_dvd_absNorm_of_le L.two_normIdeal_le_doubledScaleIdeal)
    simpa only [map_mul, htwo] using hle

end Lattice
end NormEuclidean
