import NormEuclidean.ChapterX.ReflectionApproximation
import Bong.QuadraticSpace.IsometryDeterminant

/-!
# Generation of the actual proper group by pairs of reflections

Cartan--Dieudonne is reused from the pinned general-field BongTheory proof.
The determinant character separates even words without an assumed generation
law. No spinor-kernel generation or strong approximation is asserted here.
-/

noncomputable section

namespace NormEuclidean.ProperReflectionGeneration

open ProperSpinor SpinorBaseChange Bong.QuadraticSpace

variable {K V : Type*} [Field K] [CharZero K] [AddCommGroup V] [Module K V]
variable (Q : QuadraticForm K V) (hQ : Q.polarBilin.Nondegenerate)

/-- Evaluate the upstream reflection word in the project's actual group. -/
def wordAmbient (w : ReflectionWord (SpinorBridge.quadraticSpace Q hQ)) : ambientGroup Q :=
  ⟨w.eval.toLinearEquiv, fun x ↦ by
    simpa only [SpinorBridge.quadraticSpace_quadratic] using w.eval.map_quadratic x⟩

@[simp] theorem wordAmbient_nil : wordAmbient Q hQ .nil = 1 := rfl

@[simp] theorem wordAmbient_snoc (w : ReflectionWord (SpinorBridge.quadraticSpace Q hQ))
    (x : V) (hx : (SpinorBridge.quadraticSpace Q hQ).IsAnisotropic x) :
    wordAmbient Q hQ (.snoc w x hx) =
      ambientReflection Q x (by simpa [IsAnisotropic] using hx) * wordAmbient Q hQ w := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro y
  have hx0 : Q x ≠ 0 := by simpa [IsAnisotropic] using hx
  change (SpinorBridge.quadraticSpace Q hQ).reflectionLinearEquiv x hx
      (w.eval.toLinearEquiv y) = IntegralReflection.linearEquiv Q x hx0 (w.eval.toLinearEquiv y)
  rw [SpinorBridge.reflectionLinearEquiv_eq Q hQ]

variable [FiniteDimensional K V]

/-- A subgroup containing every reflection pair contains every proper word;
an improper word becomes a member after any additional reflection. -/
theorem word_mem_of_pairs (A : Subgroup (ambientGroup Q))
    (hA : ∀ (x : V) (hx : Q x ≠ 0) (y : V) (hy : Q y ≠ 0),
      ambientReflection Q x hx * ambientReflection Q y hy ∈ A)
    (w : ReflectionWord (SpinorBridge.quadraticSpace Q hQ)) :
    (determinantHom Q (wordAmbient Q hQ w) = 1 → wordAmbient Q hQ w ∈ A) ∧
      (determinantHom Q (wordAmbient Q hQ w) = (-1 : Kˣ) →
        ∀ (x : V) (hx : Q x ≠ 0), ambientReflection Q x hx * wordAmbient Q hQ w ∈ A) := by
  induction w with
  | nil =>
    refine ⟨fun _ ↦ A.one_mem, ?_⟩
    intro hdet
    have h : (1 : K) = -1 := by
      simpa using congrArg (fun d : Kˣ ↦ (d : K)) hdet
    norm_num at h
  | snoc w y hy ih =>
    have hy0 : Q y ≠ 0 := by simpa [IsAnisotropic] using hy
    constructor
    · intro hdet
      rw [wordAmbient_snoc, map_mul, ambientReflection_det Q hQ] at hdet
      have hw : determinantHom Q (wordAmbient Q hQ w) = (-1 : Kˣ) := by
        simpa [← mul_assoc] using congrArg (fun d : Kˣ ↦ (-1) * d) hdet
      rw [wordAmbient_snoc]
      exact ih.2 hw y hy0
    · intro hdet x hx
      rw [wordAmbient_snoc, map_mul, ambientReflection_det Q hQ] at hdet
      have hw : determinantHom Q (wordAmbient Q hQ w) = 1 := by
        simpa [← mul_assoc] using congrArg (fun d : Kˣ ↦ (-1) * d) hdet
      rw [wordAmbient_snoc, ← mul_assoc]
      exact A.mul_mem (hA x hx y hy0) (ih.1 hw)

/-- The actual proper group is generated by unrestricted anisotropic pairs.
This is a proper-group result, not generation of the spinor kernel by
equal-value pairs. -/
theorem proper_mem_of_contains_doubleReflections (P : Subgroup (properGroup Q))
    (hP : ∀ (x : V) (hx : Q x ≠ 0) (y : V) (hy : Q y ≠ 0),
      doubleReflection Q hQ x hx y hy ∈ P) (g : properGroup Q) : g ∈ P := by
  let A := P.map (properGroup Q).subtype
  have hA : ∀ (x : V) (hx : Q x ≠ 0) (y : V) (hy : Q y ≠ 0),
      ambientReflection Q x hx * ambientReflection Q y hy ∈ A := by
    intro x hx y hy
    exact ⟨doubleReflection Q hQ x hx y hy, hP x hx y hy, rfl⟩
  obtain ⟨w, hw⟩ := exists_reflectionWord (ambientToBong Q hQ g.1)
  have heq : wordAmbient Q hQ w = g.1 := by
    apply Subtype.ext
    exact congrArg Isometry.toLinearEquiv hw
  have hgA : g.1 ∈ A := by
    rw [← heq]
    apply (word_mem_of_pairs Q hQ A hA w).1
    rw [heq]
    exact g.2
  obtain ⟨g', hg', he⟩ := hgA
  have hgg : g' = g := Subtype.ext he
  exact hgg ▸ hg'

end NormEuclidean.ProperReflectionGeneration
