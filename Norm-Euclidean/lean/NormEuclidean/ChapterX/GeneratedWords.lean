import NormEuclidean.ChapterX.ProperWeakApproximation

/-!
# Finite products from inverse-closed generators and coordinate subgroups
-/

noncomputable section

namespace NormEuclidean.GeneratedWords

/-- Inverse-closed generators supply literal finite products, without signed formal words. -/
theorem exists_word {G P : Type*} [Group G] (f : P → G) (rev : P → P)
    (hrev : ∀ p, (f p)⁻¹ = f (rev p)) {g : G}
    (hg : g ∈ Subgroup.closure (Set.range f)) :
    ∃ l : List P, (l.map f).prod = g := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨p, rfl⟩ := hx
      exact ⟨[p], by simp⟩
  | one => exact ⟨[], rfl⟩
  | mul g h _ _ hg hh =>
      obtain ⟨l, hl⟩ := hg
      obtain ⟨m, hm⟩ := hh
      exact ⟨l ++ m, by simp [hl, hm]⟩
  | inv g _ hg =>
      obtain ⟨l, hl⟩ := hg
      refine ⟨l.reverse.map rev, ?_⟩
      rw [← hl, List.prod_inv_reverse]
      simp only [List.map_map, List.map_reverse, Function.comp_def, hrev]

/-- Finite tuples with coordinates in specified subgroups are generated by their singles. -/
theorem mem_of_singles {ι : Type*} [Fintype ι] [DecidableEq ι]
    {G : ι → Type*} [∀ i, Group (G i)] (H : Subgroup (∀ i, G i))
    (A : ∀ i, Subgroup (G i))
    (hs : ∀ i x, x ∈ A i → MonoidHom.mulSingle G i x ∈ H)
    (a : ∀ i, G i) (ha : ∀ i, a i ∈ A i) : a ∈ H := by
  let inc : ((i : ι) → A i) →* ((i : ι) → G i) :=
    { toFun := fun x i ↦ x i
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl }
  have hs' (i : ι) (x : A i) : MonoidHom.mulSingle (fun i ↦ A i) i x ∈ H.comap inc := by
    change inc (MonoidHom.mulSingle (fun i ↦ A i) i x) ∈ H
    have heq : inc (MonoidHom.mulSingle (fun i ↦ A i) i x) =
        MonoidHom.mulSingle G i (x : G i) := by
      funext j
      by_cases hj : j = i
      · subst j
        simp [inc]
      · simp [inc, hj]
    rw [heq]
    exact hs i x x.2
  exact ProperWeakApproximation.subgroup_mem_of_singles (H.comap inc) hs'
    (fun i ↦ ⟨a i, ha i⟩)

end NormEuclidean.GeneratedWords
