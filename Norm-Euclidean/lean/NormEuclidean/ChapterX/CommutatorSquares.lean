import NormEuclidean.ChapterX.CommutatorGeneration
import Mathlib.GroupTheory.Abelianization.Defs

/-!
# The square assertions in O'Meara 43:6

The actual orthogonal abelianization has exponent two. Its commutator
subgroup contains every ambient square and is generated by proper squares.
-/

noncomputable section

namespace NormEuclidean.CommutatorSquares

open ProperSpinor SpinorBaseChange ReflectionApproximation CommutatorGeneration

variable {F E : Type*} [Field F] [CharZero F] [AddCommGroup E] [Module F E]
  [FiniteDimensional F E] (Q : QuadraticForm F E) (hQ : Q.polarBilin.Nondegenerate)

theorem reflection_sq (x : E) (hx : Q x ≠ 0) : (ambientReflection Q x hx) ^ 2 = 1 := by
  rw [pow_two]
  nth_rw 1 [← ambientReflection_inv Q x hx]
  exact inv_mul_cancel _

include hQ in
/-- Every element of the actual orthogonal abelianization has square one. -/
theorem abelianization_sq (g : ambientGroup Q) : (Abelianization.of g) ^ 2 = 1 := by
  apply ambient_induction Q hQ (fun g ↦ (Abelianization.of g) ^ 2 = 1)
  · simp
  · intro g h hg hh
    rw [map_mul, mul_pow, hg, hh, one_mul]
  · intro x hx
    rw [← map_pow, reflection_sq, map_one]

include hQ in
/-- Every actual ambient square belongs to the ambient commutator subgroup. -/
theorem square_mem_commutator (g : ambientGroup Q) : g ^ 2 ∈ commutator (ambientGroup Q) := by
  rw [← Abelianization.ker_of, MonoidHom.mem_ker, map_pow]
  exact abelianization_sq Q hQ g

include hQ in
/-- The final assertion of 43:6, with the squares of all actual proper transformations. -/
theorem proper_squares_generate :
    Subgroup.closure (Set.range (fun g : properGroup Q ↦ g.1 ^ 2)) =
      commutator (ambientGroup Q) := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, rfl⟩
    exact square_mem_commutator Q hQ g.1
  · rw [← shortSubgroup_eq_commutator Q hQ]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨p, rfl⟩
    exact Subgroup.subset_closure
      ⟨doubleReflection Q hQ p.1.1 p.1.2 p.2.1 p.2.2, rfl⟩

end NormEuclidean.CommutatorSquares
