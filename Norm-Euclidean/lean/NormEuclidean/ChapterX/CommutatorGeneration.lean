import NormEuclidean.ChapterX.ProperReflectionGeneration
import Mathlib.GroupTheory.Commutator.Basic

/-!
# O'Meara 43:6 for the actual orthogonal group

Short commutators generate the ambient commutator subgroup. The proof uses
Cartan--Dieudonne and the proved conjugation formula for actual reflections.
No local-field or spinor-kernel comparison is assumed here.
-/

noncomputable section

namespace NormEuclidean.CommutatorGeneration

open ProperSpinor SpinorBaseChange ReflectionApproximation ProperReflectionGeneration
open Bong.QuadraticSpace
open scoped commutatorElement

variable {F E : Type*} [Field F] [CharZero F] [AddCommGroup E] [Module F E]
variable (Q : QuadraticForm F E)

abbrev ReflectingPair := {x : E // Q x ≠ 0} × {y : E // Q y ≠ 0}

/-- The actual ambient short commutator attached to two anisotropic vectors. -/
def shortAmbient (p : ReflectingPair Q) : ambientGroup Q :=
  (ambientReflection Q p.1.1 p.1.2 * ambientReflection Q p.2.1 p.2.2) ^ 2

/-- The subgroup generated by actual reflection commutators. -/
def shortSubgroup : Subgroup (ambientGroup Q) := Subgroup.closure (Set.range (shortAmbient Q))

theorem short_eq_commutator (p : ReflectingPair Q) :
    shortAmbient Q p = ⁅ambientReflection Q p.1.1 p.1.2,
      ambientReflection Q p.2.1 p.2.2⁆ := by
  simp only [shortAmbient, commutatorElement_def, ambientReflection_inv, pow_two, mul_assoc]

theorem short_inv (p : ReflectingPair Q) : (shortAmbient Q p)⁻¹ = shortAmbient Q p.swap := by
  rw [short_eq_commutator, commutatorElement_inv, short_eq_commutator]
  rfl

theorem short_conj (g : ambientGroup Q) (p : ReflectingPair Q) :
    g * shortAmbient Q p * g⁻¹ = shortAmbient Q
      (⟨g.1 p.1.1, (g.2 p.1.1).trans_ne p.1.2⟩,
        ⟨g.1 p.2.1, (g.2 p.2.1).trans_ne p.2.2⟩) := by
  rw [short_eq_commutator, conjugate_commutatorElement,
    ambientReflection_conjugate, ambientReflection_conjugate, short_eq_commutator]

/-- Normality is derived from conjugation of the generating reflections. -/
instance short_normal : (shortSubgroup Q).Normal := by
  constructor
  intro n hn g
  induction hn using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨p, rfl⟩ := hx
      rw [short_conj]
      exact Subgroup.subset_closure (Set.mem_range_self _)
  | one => simp
  | mul x y _ _ hx hy =>
      change MulAut.conj g (x * y) ∈ shortSubgroup Q
      rw [map_mul]
      exact (shortSubgroup Q).mul_mem hx hy
  | inv x _ hx =>
      change MulAut.conj g x⁻¹ ∈ shortSubgroup Q
      rw [map_inv]
      exact (shortSubgroup Q).inv_mem hx

variable [FiniteDimensional F E] (hQ : Q.polarBilin.Nondegenerate)

include hQ

/-- Positive reflection words give induction over every actual orthogonal transformation. -/
theorem ambient_induction (P : ambientGroup Q → Prop) (hone : P 1)
    (hmul : ∀ g h, P g → P h → P (g * h))
    (href : ∀ (x : E) (hx : Q x ≠ 0), P (ambientReflection Q x hx))
    (g : ambientGroup Q) : P g := by
  obtain ⟨w, hw⟩ := exists_reflectionWord (ambientToBong Q hQ g)
  have heq : wordAmbient Q hQ w = g := by
    apply Subtype.ext
    exact congrArg Isometry.toLinearEquiv hw
  rw [← heq]
  clear hw heq
  induction w with
  | nil => exact hone
  | snoc w x hx ih =>
      rw [wordAmbient_snoc]
      exact hmul _ _ (href x (by simpa [IsAnisotropic] using hx)) ih

theorem reflection_commutator_mem (x : E) (hx : Q x ≠ 0) (g : ambientGroup Q) :
    ⁅ambientReflection Q x hx, g⁆ ∈ shortSubgroup Q := by
  apply ambient_induction Q hQ (fun g ↦ ⁅ambientReflection Q x hx, g⁆ ∈ shortSubgroup Q)
  · simpa using (shortSubgroup Q).one_mem
  · intro g h hg hh
    rw [commutatorElement_mul_right_eq_mul_conj]
    simpa only [mul_assoc] using
      (shortSubgroup Q).mul_mem hg ((short_normal Q).conj_mem _ hh g)
  · intro y hy
    rw [← short_eq_commutator Q (⟨x, hx⟩, ⟨y, hy⟩)]
    exact Subgroup.subset_closure (Set.mem_range_self _)

theorem commutator_mem_short (g h : ambientGroup Q) : ⁅g, h⁆ ∈ shortSubgroup Q := by
  apply ambient_induction Q hQ (fun g ↦ ⁅g, h⁆ ∈ shortSubgroup Q)
  · simpa using (shortSubgroup Q).one_mem
  · intro g k hg hk
    rw [commutatorElement_mul_left_eq_conj_mul]
    exact (shortSubgroup Q).mul_mem ((short_normal Q).conj_mem _ hk g) hg
  · intro x hx
    exact reflection_commutator_mem Q hQ x hx h

/-- O'Meara 43:6: the actual ambient commutator group is generated by short commutators. -/
theorem shortSubgroup_eq_commutator : shortSubgroup Q = commutator (ambientGroup Q) := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨p, rfl⟩
    rw [short_eq_commutator, commutator_eq_closure]
    exact Subgroup.subset_closure (commutator_mem_commutatorSet _ _)
  · rw [commutator_eq_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, h, rfl⟩
    exact commutator_mem_short Q hQ g h

end NormEuclidean.CommutatorGeneration
