import NormEuclidean.ChapterX.IdealClassRepresentatives
import NormEuclidean.ChapterX.ScalarIntegralApproximation
import Mathlib.GroupTheory.OrderOfElement

/-!
# Denominators supported on prescribed finite primes

The actual finite ideal class group makes a positive power of each prime
principal. Its generator is supported on that one prime. Products of powers
then clear an arbitrary finite collection of completed scalar denominators
without introducing any other prime divisor.
-/

noncomputable section

namespace NormEuclidean.PrimePowerDenominator

open IsDedekindDomain CompletedIntegralLattice ScalarIntegralApproximation Filter Topology
open scoped nonZeroDivisors WithZero

variable {K : Type*} [Field K] [NumberField K]

local instance : Fintype (ClassGroup (integerSubring K)) :=
  inferInstanceAs (Fintype (ClassGroup (NumberField.RingOfIntegers K)))

/-- A positive power of an actual finite prime is generated by a nonzero
integer supported exactly at that prime. No principal ideal ring is assumed. -/
theorem exists_single_prime_scalar (v : HeightOneSpectrum (integerSubring K)) :
    ∃ d : integerSubring K, d ≠ 0 ∧ d ∈ v.asIdeal ∧
      ∀ w : HeightOneSpectrum (integerSubring K), w ≠ v → d ∉ w.asIdeal := by
  let P : (Ideal (integerSubring K))⁰ :=
    ⟨v.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.ne_bot⟩
  let n := orderOf (ClassGroup.mk0 P)
  have hn : 0 < n := orderOf_pos _
  have hp : (v.asIdeal ^ n).IsPrincipal := by
    apply (ClassGroup.mk0_eq_one_iff (P ^ n).property).mp
    change ClassGroup.mk0 (P ^ n) = 1
    rw [map_pow]
    exact pow_orderOf_eq_one _
  obtain ⟨d, hd⟩ := hp.principal
  have hd0 : d ≠ 0 := by
    intro hzero
    have hpow : v.asIdeal ^ n = ⊥ := by
      simpa only [hzero, Submodule.span_zero_singleton] using hd
    exact pow_ne_zero n v.ne_bot hpow
  have hdeq : v.asIdeal ^ n = Ideal.span {d} := hd
  have hdv : d ∈ v.asIdeal := by
    have hle : v.asIdeal ^ n ≤ v.asIdeal := Ideal.pow_le_self (Nat.ne_zero_of_lt hn)
    exact hle (hdeq.symm ▸ Ideal.subset_span (Set.mem_singleton d))
  refine ⟨d, hd0, hdv, ?_⟩
  intro w hw hdw
  have hle : v.asIdeal ^ n ≤ w.asIdeal := by
    rw [hdeq]
    exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hdw)
  have hprime : v.asIdeal ≤ w.asIdeal := Ideal.IsPrime.le_of_pow_le hle
  have heq : v = w := HeightOneSpectrum.ext_iff.mpr
    (v.isMaximal.eq_of_le w.isPrime.ne_top hprime)
  exact hw heq.symm

/-- A power of a nonzero integer in one prime clears any scalar denominator
at that actual completion. The power is obtained from convergence to zero. -/
theorem exists_power_clearing_local (v : HeightOneSpectrum (integerSubring K))
    (d : integerSubring K) (hd : d ∈ v.asIdeal) (x : LocalField (integerSubring K) v) :
    ∃ n : ℕ, algebraMap K (LocalField (integerSubring K) v) ((d : K) ^ n) * x ∈
      LocalRing (integerSubring K) v := by
  have hlt : Valued.v (algebraMap K (LocalField (integerSubring K) v) (d : K)) < 1 := by
    rw [valuation_algebraMap]
    exact (HeightOneSpectrum.valuation_lt_one_iff_mem (K := K) v d).mpr hd
  have ht : Tendsto (fun n : ℕ ↦
      algebraMap K (LocalField (integerSubring K) v) (d : K) ^ n * x) atTop (𝓝 0) := by
    simpa only [zero_mul] using (Valued.tendsto_zero_pow_of_v_lt_one hlt).mul_const x
  have hnb : (LocalRing (integerSubring K) v : Set (LocalField (integerSubring K) v)) ∈ 𝓝 0 :=
    (OrthogonalTopology.isOpen_localRing _ _).mem_nhds (Subring.zero_mem _)
  obtain ⟨n, hn⟩ := (ht.eventually_mem hnb).exists
  change Valued.v (algebraMap K (LocalField (integerSubring K) v) (d : K) ^ n * x) ≤ 1 at hn
  refine ⟨n, ?_⟩
  change Valued.v (algebraMap K (LocalField (integerSubring K) v) ((d : K) ^ n) * x) ≤ 1
  rwa [map_pow]

/-- One global integral denominator clears arbitrary finitely many local
scalar targets and is a unit at every other finite prime. -/
theorem exists_supported_denominator (T : Finset (HeightOneSpectrum (integerSubring K)))
    (x : (v : T) → LocalField (integerSubring K) v.1) :
    ∃ d : integerSubring K, d ≠ 0 ∧
      (∀ v : T, algebraMap K (LocalField (integerSubring K) v.1) (d : K) * x v ∈
        LocalRing (integerSubring K) v.1) ∧
      ∀ w : HeightOneSpectrum (integerSubring K), w ∉ T → d ∉ w.asIdeal := by
  classical
  choose a ha0 hav haw using fun v : T ↦ exists_single_prime_scalar v.1
  choose n hn using fun v : T ↦ exists_power_clearing_local v.1 (a v) (hav v) (x v)
  let f : T → integerSubring K := fun v ↦ a v ^ n v
  let d : integerSubring K := ∏ v : T, f v
  have hd0 : d ≠ 0 := Finset.prod_ne_zero_iff.mpr
    (fun v _ ↦ pow_ne_zero (n v) (ha0 v))
  refine ⟨d, hd0, ?_, ?_⟩
  · intro v
    obtain ⟨b, hb⟩ := Finset.dvd_prod_of_mem f (Finset.mem_univ v)
    have heq : d = a v ^ n v * b := hb
    rw [heq, Subring.coe_mul, Subring.coe_pow, map_mul, mul_assoc,
      mul_comm (algebraMap K (LocalField (integerSubring K) v.1) (b : K)) (x v),
      ← mul_assoc]
    exact (LocalRing (integerSubring K) v.1).mul_mem (hn v)
      (algebraMap_mem (integerSubring K) v.1 b.property)
  · intro w hw
    have hf : ∀ v : T, f v ∉ w.asIdeal := by
      intro v
      exact w.asIdeal.primeCompl.pow_mem (haw v w (fun heq ↦ hw (heq ▸ v.2))) (n v)
    exact w.asIdeal.primeCompl.prod_mem (fun v _ ↦ hf v)

end NormEuclidean.PrimePowerDenominator
