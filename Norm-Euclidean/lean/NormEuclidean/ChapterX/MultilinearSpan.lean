import NormEuclidean.ChapterX.VolumeIdeal

/-!
# Determinants on spanning generators

A coordinatewise span induction reduces multilinear values to their values
on spanning generators. This will apply to both families in the intrinsic
mixed determinant ideal, including modules without an integral basis.
-/

noncomputable section

namespace NormEuclidean.IntegralVolume

/-- Multilinearity extends a submodule-valued conclusion from generators to
arbitrary tuples in their spans. The proof expands each coordinate. -/
theorem multilinear_mem_of_mem_span {R M N ι : Type*} [CommSemiring R]
    [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N] [Fintype ι]
    (f : MultilinearMap R (fun _ : ι ↦ M) N) (S : Set M) (P : Submodule R N)
    (hf : ∀ m : ι → M, (∀ i, m i ∈ S) → f m ∈ P)
    (m : ι → M) (hm : ∀ i, m i ∈ Submodule.span R S) : f m ∈ P := by
  classical
  have h (s : Finset ι) : ∀ m : ι → M,
      (∀ i ∈ s, m i ∈ Submodule.span R S) →
      (∀ i ∉ s, m i ∈ S) → f m ∈ P := by
    induction s using Finset.induction_on with
    | empty =>
      intro m _ hm
      exact hf m (fun i ↦ hm i (Finset.notMem_empty i))
    | @insert i s hi ih =>
      intro m hm hs
      suffices hcoord : ∀ a ∈ Submodule.span R S, f (Function.update m i a) ∈ P by
        simpa only [Function.update_eq_self] using hcoord (m i) (hm i (by simp))
      intro a ha
      induction ha using Submodule.span_induction with
      | mem a ha =>
        apply ih (Function.update m i a)
        · intro j hj
          have hji : j ≠ i := fun h ↦ hi (h ▸ hj)
          simpa only [Function.update_of_ne hji] using
            hm j (Finset.mem_insert_of_mem hj)
        · intro j hj
          by_cases hji : j = i
          · subst j
            simpa using ha
          · simpa only [Function.update_of_ne hji] using hs j (by simp [hj, hji])
      | zero => simpa using P.zero_mem
      | add a b _ _ ha hb =>
        rw [f.map_update_add]
        exact P.add_mem ha hb
      | smul r a _ ha =>
        rw [f.map_update_smul]
        exact P.smul_mem r ha
  exact h Finset.univ m (fun i _ ↦ hm i) (by simp)

variable {K V : Type*} [Field K] [NumberField K] [AddCommGroup V] [Module K V]

/-- Row-pairing is an actual field-linear map. -/
def pairingRows (B : LinearMap.BilinForm K V) {n : ℕ} (y : Fin n → V) :
    V →ₗ[K] (Fin n → K) := LinearMap.pi fun j ↦ B.flip (y j)

/-- The mixed determinant as an alternating map in its first family. -/
def determinantLeft (B : LinearMap.BilinForm K V) (n : ℕ) (y : Fin n → V) :
    V [⋀^Fin n]→ₗ[K] K :=
  Matrix.detRowAlternating.compLinearMap (pairingRows B y)

@[simp]
theorem determinantLeft_apply (B : LinearMap.BilinForm K V) (n : ℕ) (x y : Fin n → V) :
    determinantLeft B n y x = (pairingMatrix B x y).det := rfl

/-- Reversing the two families and the pairing transposes the mixed matrix. -/
theorem det_pairingMatrix_flip (B : LinearMap.BilinForm K V) (n : ℕ) (x y : Fin n → V) :
    (pairingMatrix B.flip y x).det = (pairingMatrix B x y).det := by
  have h : pairingMatrix B.flip y x = (pairingMatrix B x y).transpose := rfl
  rw [h, Matrix.det_transpose]

/-- A volume bound verified on spanning generators holds on the whole module.
The two coordinatewise span inductions use the actual determinant maps. -/
theorem volumeSubmodule_le_of_generators (B : LinearMap.BilinForm K V) (n : ℕ)
    (S : Set V) (P : Submodule (integerSubring K) K)
    (h : ∀ x y : Fin n → V, (∀ i, x i ∈ S) → (∀ j, y j ∈ S) →
      (pairingMatrix B x y).det ∈ P) :
    volumeSubmodule B n (Submodule.span (integerSubring K) S) ≤ P := by
  apply Submodule.span_le.mpr
  rintro _ ⟨p, rfl⟩
  apply multilinear_mem_of_mem_span
    ((determinantLeft B n (fun j ↦ (p.2 j : V))).toMultilinearMap.restrictScalars
      (integerSubring K)) S P
  · intro x hx
    have hright := multilinear_mem_of_mem_span
      ((determinantLeft B.flip n x).toMultilinearMap.restrictScalars (integerSubring K))
      S P (fun y hy ↦ by
        change (pairingMatrix B.flip y x).det ∈ P
        rw [det_pairingMatrix_flip]
        exact h x y hx hy)
      (fun j ↦ (p.2 j : V)) (fun j ↦ (p.2 j).2)
    change (pairingMatrix B.flip (fun j ↦ (p.2 j : V)) x).det ∈ P at hright
    rw [det_pairingMatrix_flip] at hright
    exact hright
  · exact fun i ↦ (p.1 i).2

/-- On a module generated by `n` vectors, volume is the principal Gram
determinant ideal. In particular this verifies the usual free-basis convention. -/
theorem volumeSubmodule_span_n_vectors (B : LinearMap.BilinForm K V) (n : ℕ)
    (b : Fin n → V) :
    volumeSubmodule B n (Submodule.span (integerSubring K) (Set.range b)) =
      Submodule.span (integerSubring K) {(pairingMatrix B b b).det} := by
  classical
  let P := Submodule.span (integerSubring K) {(pairingMatrix B b b).det}
  have hbase : (pairingMatrix B b b).det ∈ P :=
    Submodule.subset_span (Set.mem_singleton _)
  apply le_antisymm
  · apply volumeSubmodule_le_of_generators
    intro x y hx hy
    choose f hf using hx
    choose g hg using hy
    by_cases hfi : Function.Injective f
    · by_cases hgi : Function.Injective g
      · let σ : Equiv.Perm (Fin n) := Equiv.ofBijective f
          (Finite.injective_iff_bijective.mp hfi)
        let τ : Equiv.Perm (Fin n) := Equiv.ofBijective g
          (Finite.injective_iff_bijective.mp hgi)
        have hmat : pairingMatrix B x y =
            ((pairingMatrix B b b).submatrix id τ).submatrix σ id := by
          ext i j
          change B (x i) (y j) = B (b (f i)) (b (g j))
          rw [hf i, hg j]
        rw [hmat, Matrix.det_permute, Matrix.det_permute']
        have h := P.smul_mem (((Equiv.Perm.sign τ : ℤ) : integerSubring K)) hbase
        have h' := P.smul_mem (((Equiv.Perm.sign σ : ℤ) : integerSubring K)) h
        simpa only [Subring.smul_def, Subring.coe_intCast, smul_eq_mul] using h'
      · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.mp hgi
        have hzero : (pairingMatrix B x y).det = 0 :=
          Matrix.det_zero_of_column_eq hne (by
            intro k
            change B (x k) (y i) = B (x k) (y j)
            rw [← hg i, ← hg j, hij])
        rw [hzero]
        exact P.zero_mem
    · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.mp hfi
      have hzero : (pairingMatrix B x y).det = 0 :=
        Matrix.det_zero_of_row_eq hne (by
          ext k
          change B (x i) (y k) = B (x j) (y k)
          rw [← hf i, ← hf j, hij])
      rw [hzero]
      exact P.zero_mem
  · apply Submodule.span_le.mpr
    rintro _ rfl
    exact det_mem_volumeSubmodule B n _ b b
      (fun i ↦ Submodule.subset_span (Set.mem_range_self i))
      (fun j ↦ Submodule.subset_span (Set.mem_range_self j))

end NormEuclidean.IntegralVolume
