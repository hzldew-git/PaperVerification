import NormEuclidean.ChapterX.HerbrandIndex
import NormEuclidean.ChapterX.SUnitRanks
import NormEuclidean.ChapterX.SUnitHilbert90Exact
import Mathlib.GroupTheory.FiniteAbelian.Basic

/-!
# A concrete finite-index core for Herbrand's lemma

The subgroup generated by the norm and difference images contains all
squares. Finite generation proves its finite index. The square identity
also proves both finite-index side conditions inside its fixed kernels,
so Herbrand applies without accepting any of these indices as premises.
-/

noncomputable section

namespace NormEuclidean.NormDifferenceCore

variable {G : Type*} [CommGroup G] [Group.FG G]

/-- A concrete core built only from the two actual images. -/
def imageCore (N T : G →* G) : Subgroup G := N.range ⊔ T.range

/-- The square identity proves that the image core has finite index. -/
theorem finiteIndex_imageCore (N T : G →* G) (hsquare : ∀ x, x ^ 2 = N x * T x) :
    (imageCore N T).FiniteIndex := by
  letI : (powMonoidHom (α := G) 2).range.FiniteIndex :=
    Subgroup.finiteIndex_range_powMonoidHom_of_fg _ (by decide : 2 ≠ 0)
  apply Subgroup.finiteIndex_of_le (H := (powMonoidHom (α := G) 2).range)
  rintro _ ⟨x, rfl⟩
  change x ^ 2 ∈ N.range ⊔ T.range
  rw [hsquare]
  exact Subgroup.mul_mem_sup ⟨x, rfl⟩ ⟨x, rfl⟩

/-- Squares in a fixed kernel are norm images from that same subgroup.
This proves the local finiteness condition required by Herbrand. -/
theorem finite_relative_kernel (P : Subgroup G) (N T : G →* G)
    (hsquare : ∀ x, x ^ 2 = N x * T x) :
    (P.map N).IsFiniteRelIndex (P ⊓ T.ker) := by
  let B := P ⊓ T.ker
  letI : Group.FG B := by
    letI : Module.Finite ℤ (Additive G) :=
      Module.Finite.iff_addGroup_fg.mpr inferInstance
    letI : Module.Finite ℤ (Additive B) := Module.Finite.of_injective
      (MonoidHom.toAdditive B.subtype).toIntLinearMap B.subtype_injective
    exact GroupFG.iff_add_fg.mpr (Module.Finite.iff_addGroup_fg.mp inferInstance)
  letI : (B.map (powMonoidHom (α := G) 2)).IsFiniteRelIndex B :=
    Subgroup.isFiniteRelIndex_map_powMonoidHom_of_fg
      ((Group.fg_iff_subgroup_fg B).mp inferInstance) (by decide : 2 ≠ 0)
  apply Subgroup.isFiniteRelIndex_of_le_left (H := B.map (powMonoidHom (α := G) 2)) B
  rintro _ ⟨x, hx, rfl⟩
  refine ⟨x, hx.1, ?_⟩
  change N x = x ^ 2
  rw [hsquare, show T x = 1 from hx.2, mul_one]

/-- Herbrand on the image core, with its finite index and both local
finiteness conditions proved internally. -/
theorem herbrand_imageCore (N T : G →* G)
    (hNT : N.range ≤ T.ker) (hTN : T.range ≤ N.ker)
    (hsquare : ∀ x, x ^ 2 = N x * T x) :
    let P := imageCore N T
    N.range.relIndex T.ker * (P.map T).relIndex (P ⊓ N.ker) =
      T.range.relIndex N.ker * (P.map N).relIndex (P ⊓ T.ker) ∧
      N.range.relIndex T.ker ≠ 0 ∧ T.range.relIndex N.ker ≠ 0 := by
  let P := imageCore N T
  letI := finiteIndex_imageCore N T hsquare
  letI := finite_relative_kernel P N T hsquare
  letI := finite_relative_kernel P T N (fun x ↦ (hsquare x).trans (mul_comm _ _))
  apply HerbrandIndex.herbrand P N T Subgroup.FiniteIndex.index_ne_zero hNT hTN
  · exact (P.map_le_range N).trans le_sup_left
  · exact (P.map_le_range T).trans le_sup_right
  · exact Subgroup.IsFiniteRelIndex.relIndex_ne_zero
  · exact Subgroup.IsFiniteRelIndex.relIndex_ne_zero

open IsDedekindDomain ExtensionIdeleNorm QuadraticExtensionNorm SUnitNormArithmetic
open scoped NumberField

universe u
variable {K : Type u} [Field K] [NumberField K]

/-- The actual quadratic S-unit norm and difference maps admit Herbrand's
comparison, with no supplied finite-index core or local index premises. -/
theorem actual_sUnit_herbrand (theta : Kˣ) (htheta : ¬ IsSquare theta)
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : Sᶜ.Finite) :
    letI := quadraticExtensionField theta htheta
    letI := quadraticExtensionNumberField theta htheta
    let N := normEnd (QuadraticStableKernel.conjugation theta.val) S
    let T := differenceEnd (QuadraticStableKernel.conjugation theta.val) S
    let P := imageCore N T
    N.range.relIndex T.ker * (P.map T).relIndex (P ⊓ N.ker) =
      T.range.relIndex N.ker * (P.map N).relIndex (P ⊓ T.ker) ∧
      N.range.relIndex T.ker ≠ 0 ∧ T.range.relIndex N.ker ≠ 0 := by
  letI := quadraticExtensionField theta htheta
  letI := quadraticExtensionNumberField theta htheta
  have hcof : (finitePlacesOverSet (E := QuadraticAlgebra K theta.val 0) S)ᶜ.Finite :=
    NormFiberAssembly.finite_preimage_under Sᶜ hS
  letI := SUnitFiniteness.moduleFinite_sUnits
    (finitePlacesOverSet (E := QuadraticAlgebra K theta.val 0) S) hcof
  letI : Group.FG (sUnitSubgroup
      (finitePlacesOverSet (E := QuadraticAlgebra K theta.val 0) S)) :=
    GroupFG.iff_add_fg.mpr (Module.Finite.iff_addGroup_fg.mp inferInstance)
  apply herbrand_imageCore
  · rintro _ ⟨x, rfl⟩
    exact difference_norm _ (fun z ↦ star_star z) S x
  · rintro _ ⟨x, rfl⟩
    exact norm_difference _ (fun z ↦ star_star z) S x
  · exact square_eq_norm_mul_difference _ S

end NormEuclidean.NormDifferenceCore
