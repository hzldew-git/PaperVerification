/-- The finite-field certificates are replayed by the Lean kernel. -/
theorem degreeFiveCriticalRabinCertificates_checked :
    rabinCertificateBatchCheck 5 degreeFiveCriticalRows
      degreeFiveCriticalRabinCertificates = true := by
  decide

/-- Every critical quintic is irreducible over the integers. -/
theorem degreeFiveCriticalRows_irreducible :
    ∀ row ∈ degreeFiveCriticalRows, Irreducible row.polynomial :=
  irreducible_of_batchCheck_eq_true 5
    degreeFiveCriticalRabinCertificates_checked

end TraceEuclidean
